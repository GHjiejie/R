# PostgreSQL 连接串（示例配置，不含真实密码）
DATABASE_URL=postgresql+psycopg2://demo:demo123@localhost:5432/userdb

# Redis 连接（示例配置）
REDIS_URL=redis://localhost:6379/0

# 缓存 TTL（秒）
CACHE_TTL=60

# 空值缓存 TTL（秒，防缓存穿透，建议短于 CACHE_TTL）
NULL_CACHE_TTL=30

# TTL 随机扰动上限（秒，防缓存雪崩：实际 TTL = CACHE_TTL + 0~CACHE_TTL_JITTER）
CACHE_TTL_JITTER=30
